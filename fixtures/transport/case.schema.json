{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/basics-only/bae6-contracts/fixtures/transport/case.schema.json",
  "title": "TransportCase",
  "type": "object",
  "required": ["name", "request", "responses", "expect", "expectRequestCount"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string" },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "timeoutMs": { "type": "integer", "minimum": 1 } }
    },
    "request": {
      "type": "object",
      "required": ["method", "path"],
      "additionalProperties": false,
      "properties": {
        "method": { "enum": ["GET", "POST", "PUT", "DELETE"] },
        "path": { "type": "string", "pattern": "^/" },
        "body": {},
        "idempotencyKey": { "type": "string" }
      }
    },
    "responses": {
      "description": "Answered in order, one per request received.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": { "type": "integer" },
          "headers": { "type": "object", "additionalProperties": { "type": "string" } },
          "body": {},
          "delayMs": { "type": "integer", "minimum": 0 },
          "drop": { "const": true }
        }
      }
    },
    "expectRequestCount": { "type": "integer", "minimum": 1 },
    "expect": {
      "oneOf": [
        { "type": "object", "required": ["result"], "additionalProperties": false, "properties": { "result": {} } },
        {
          "type": "object",
          "required": ["error"],
          "additionalProperties": false,
          "properties": {
            "error": {
              "type": "object",
              "required": ["kind"],
              "additionalProperties": false,
              "properties": {
                "kind": { "enum": ["api", "timeout", "connection", "invalid_response"] },
                "status": { "type": "integer" },
                "code": { "type": ["string", "null"] },
                "requestId": { "type": "string" },
                "retryAfterSeconds": { "type": "integer" }
              }
            }
          }
        }
      ]
    }
  }
}
