{
  "name": "does not retry a 503 that asks the caller to wait longer than a second",
  "request": { "method": "GET", "path": "/v1/things" },
  "responses": [
    { "status": 503, "body": { "code": "unavailable", "message": "Down.", "requestId": "req_8", "retryAfterSeconds": 30 } },
    { "status": 200, "body": {} }
  ],
  "expectRequestCount": 1,
  "expect": { "error": { "kind": "api", "status": 503, "code": "unavailable", "requestId": "req_8", "retryAfterSeconds": 30 } }
}
